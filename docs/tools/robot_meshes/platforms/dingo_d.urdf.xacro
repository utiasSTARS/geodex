<?xml version="1.0"?>
<!-- Clearpath Dingo-D (DD100) with differential drive, from the pinned clearpath_common
     macros, drawn by the docs robot viewer. -->
<robot name="dingo_d" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="use_platform_controllers" default="false"/>
  <xacro:include filename="$(find clearpath_platform_description)/urdf/common.urdf.xacro"/>
  <xacro:include filename="$(find clearpath_platform_description)/urdf/dd100/dd100.urdf.xacro"/>
  <xacro:dd100/>
</robot>
