// Registry entry of the @GEODEX_VAMP_ROBOT@ kernel, generated by cmake/vamp_robots.cmake.
// Each kernel compiles in its own translation unit, and the robots build in parallel.

#include "geodex/integration/vamp/detail/robot_impl.hpp"
#include "geodex/integration/vamp/robots/@GEODEX_VAMP_ROBOT@.hpp"
#include "robot_entry.hpp"

namespace geodex::integration::vamp::detail {

auto robot_entry_@GEODEX_VAMP_ROBOT@() -> RobotEntry {
  using Model = @GEODEX_VAMP_ROBOT@_model;
  static constexpr const auto& sweep = generated::@GEODEX_VAMP_ROBOT@_sweep;
  static_assert(sweep.lower.size() == Model::dimension);
  return {
      "@GEODEX_VAMP_ROBOT@",
      static_cast<int>(Model::dimension),
      Model::joint_names,
      Model::end_effector,
      [](EnvHandle env) -> std::unique_ptr<CollisionChecker> {
        return std::make_unique<VampCollisionCheckerImpl<Model>>(std::move(env), sweep);
      },
      [](const ompl::base::SpaceInformationPtr& si,
         EnvHandle env) -> std::unique_ptr<ompl::base::MotionValidator> {
        if constexpr (sweep.planar_base) {
          return std::make_unique<VampInterpolatedMotionValidatorImpl<Model>>(si, std::move(env),
                                                                              sweep);
        } else {
          return std::make_unique<VampMotionValidatorImpl<Model>>(si, std::move(env));
        }
      },
      [](const ompl::base::SpaceInformationPtr& si, EnvHandle env,
         double step) -> std::unique_ptr<ompl::base::MotionValidator> {
        return std::make_unique<VampCertifiedMotionValidatorImpl<Model>>(si, std::move(env),
                                                                         sweep, step);
      },
      [](const double* q) { return sphere_positions<Model>(q); },
      [](const EnvHandle& env) { return travel_bound(sweep, env_cast(env)); },
  };
}

}  // namespace geodex::integration::vamp::detail
